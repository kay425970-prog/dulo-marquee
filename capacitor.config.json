{
  "appId": "app.arkaflix.marquee",
  "appName": "arkaflix",
  "webDir": "public",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "url": "https://arkaflix.netlify.app",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false
    }
  }
}
